// Tang Nano 9K — GW1NR-LV9QN88PC6/I5 pin constraints
// Copy only the lines your current top module uses.
// Every port in top.v must appear here or nextpnr-himbaechel will error.
//
// All on-board I/O verified against:
//   https://senolgulgonul.github.io/verilog/weeks/tang-nano-9k-reference.html
//   https://wiki.sipeed.com/hardware/en/tang/Tang-Nano-9K/Nano-9K.html

// ── Clock ────────────────────────────────────────────────────────────────────
// 27 MHz crystal oscillator output
IO_LOC  "clk" 52;
IO_PORT "clk" PULL_MODE=UP;

// ── LEDs (active-LOW: drive 0 to light, drive 1 to extinguish) ───────────────
// Common-anode wired to 3V3; keep logic positive, invert at the pin:
//   assign led = ~value;
IO_LOC  "led[0]" 10; IO_PORT "led[0]" PULL_MODE=UP DRIVE=8;
IO_LOC  "led[1]" 11; IO_PORT "led[1]" PULL_MODE=UP DRIVE=8;
IO_LOC  "led[2]" 13; IO_PORT "led[2]" PULL_MODE=UP DRIVE=8;
IO_LOC  "led[3]" 14; IO_PORT "led[3]" PULL_MODE=UP DRIVE=8;
IO_LOC  "led[4]" 15; IO_PORT "led[4]" PULL_MODE=UP DRIVE=8;
IO_LOC  "led[5]" 16; IO_PORT "led[5]" PULL_MODE=UP DRIVE=8;

// ── Buttons (active-LOW: pressed = 0, released = 1) ──────────────────────────
// S1 = right button (closer to USB-C), S2 = left button
IO_LOC  "btn[0]" 4; IO_PORT "btn[0]" PULL_MODE=UP;   // S1
IO_LOC  "btn[1]" 3; IO_PORT "btn[1]" PULL_MODE=UP;   // S2

// ── UART (via on-board CH552 USB-UART bridge) ─────────────────────────────────
// No external wires needed — connect USB-C and open a serial port on the host.
// Default baud is up to you; 115200 is conventional.
IO_LOC  "uart_tx" 17; IO_PORT "uart_tx" PULL_MODE=UP DRIVE=8;
IO_LOC  "uart_rx" 18; IO_PORT "uart_rx" PULL_MODE=UP;

// ── Audio output (PWM / GPIO) ─────────────────────────────────────────────────
// Uncomment when you add audio output to your design.
// Wire the chosen GPIO pin through a 100 Ω resistor + 10 µF cap to a 3.5 mm jack
// for a crude low-pass filter suitable for square-wave output.
// Any free header pin works; 25 is a convenient starting point.
//
// IO_LOC  "audio_out" 25; IO_PORT "audio_out" IO_TYPE=LVCMOS33 DRIVE=8;
